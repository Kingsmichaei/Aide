# Copy to .env and fill in. Never commit .env.
# The back end reads this file from the repo root; the front end only sees VITE_* keys.

# Back end
DATABASE_URL=postgresql+psycopg://aide:aide@localhost:5432/aide
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
CHANNEL3_API_KEY=
KERNEL_API_KEY=
RENDER_API_KEY=
FRONTEND_URL=http://localhost:5173

# Front end (baked in at build time)
VITE_API_URL=http://localhost:8000
