# Copy to .env and fill in. Never commit .env.
# Back-end settings. The back end reads backend/.env and the repo-root .env.
# Front-end keys live in frontend/.env (see frontend/.env.example).

DATABASE_URL=postgresql+psycopg://aide:aide@localhost:5432/aide
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
CHANNEL3_API_KEY=
KERNEL_API_KEY=
RENDER_API_KEY=
FRONTEND_URL=http://localhost:5173
