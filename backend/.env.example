# Copy to backend/.env and fill in. Never commit .env.
# Front-end keys live in frontend/.env (see frontend/.env.example).

# Local development uses a SQLite file in backend/. Render sets a Postgres URL.
DATABASE_URL=sqlite:///./aide.db
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
CHANNEL3_API_KEY=
KERNEL_API_KEY=
RENDER_API_KEY=
# Orders ledger and charts (AG Grid / AG Charts) and the planner (Bryntum), Day 7.
AG_GRID_LICENSE_KEY=
BRYNTUM_LICENSE=
FRONTEND_URL=http://localhost:5173
# Signs the session cookie. Any long random string; leave empty locally to get a
# new one on each restart (everyone is signed out then).
SECRET_KEY=
# true in production (https). Must stay false for http://localhost.
COOKIE_SECURE=false
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
