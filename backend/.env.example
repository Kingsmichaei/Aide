# Copy to backend/.env and fill in. Never commit .env.
# Front-end keys live in frontend/.env (see frontend/.env.example).

# Local development uses a SQLite file in backend/. Render sets a Postgres URL.
DATABASE_URL=sqlite:///aide.db
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=SANDBOX
CHANNEL3_API_KEY=
KERNEL_API_KEY=
RENDER_API_KEY=
FRONTEND_URL=http://localhost:5173
