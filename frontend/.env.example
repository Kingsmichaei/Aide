# Copy to frontend/.env. Vite builds these into the bundle, so never put secrets here.

VITE_API_URL=http://localhost:8000
# Same sandbox client id as PAYPAL_CLIENT_ID (client ids are safe to expose)
VITE_PAYPAL_CLIENT_ID=
# Shopper id printed by `uv run python -m app.seed` (no sign-in yet)
VITE_DEMO_SHOPPER_ID=1
