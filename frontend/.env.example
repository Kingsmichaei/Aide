# Copy to frontend/.env. Vite builds these into the bundle, so never put secrets here.

# Leave unset: the app calls /api on its own origin, which Vite (dev) and
# Render (prod) forward to the back end, so the session cookie works.
# VITE_API_URL=/api
# Same sandbox client id as PAYPAL_CLIENT_ID (client ids are safe to expose)
VITE_PAYPAL_CLIENT_ID=
